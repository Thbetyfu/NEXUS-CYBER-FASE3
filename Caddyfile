{
    # Konfigurasi Global Caddy
    on_demand_tls {
        # Validasi domain dinamis melalui endpoint Go WAF Gateway
        ask http://gateway:8080/api/license/validate-domain
    }
    
    # Batasi log admin local Caddy
    admin off
}

# 1. Routing Nexus Command Center (Next.js Admin Dashboard)
# Sesuai untuk akses administrasi tersentralisasi
:3000 {
    # SOC APIs only — public site traffic stays on :80/:443 -> gateway:8080
    handle /api/* {
        reverse_proxy gateway:8081
    }
    
    # Alihkan sisa request ke Next.js Admin Dashboard
    handle {
        reverse_proxy dashboard:3000
    }
}

# 2. Routing satu hostname klien (bukan SaaS multi-tenant)
# On-Demand TLS: Caddy ask gateway /api/license/validate-domain.
# Hanya host yang HasExplicitRoute (termasuk PROTECTED_HOST) yang boleh dapat sertifikat.
# :8081 / dasbor tidak di-bind ke 0.0.0.0 di sini.
:443 {
    tls {
        on_demand
    }
    
    reverse_proxy gateway:8080
}

# 3. Routing HTTP (SEMENTARA UNTUK IP PUBLIC)
:80 {
    reverse_proxy gateway:8080
}
