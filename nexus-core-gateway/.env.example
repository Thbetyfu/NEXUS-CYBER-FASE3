# Nexus Cyber Core Gateway - Environment Variables
# Copy this file to .env and fill in your values
# ===================================================

# API & Licensing
PORT=8080
SAAS_LICENSE_API_URL=http://127.0.0.1:3003/api/license
NEXUS_LICENSE_DOMAIN=localhost
NEXUS_LICENSE_KEY=nexus-cyber-dev
LICENSE_GRACE_PERIOD_MINUTES=360
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXUS_PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret

# Target Backend (Protected Application)
TARGET_BACKEND_HOST=localhost
TARGET_BACKEND=http://127.0.0.1:3001

# Redis (Bound to 127.0.0.1)
REDIS_URL=127.0.0.1:6379

# PostgreSQL (Bound to 127.0.0.1)
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/nexus_cyber_gateway?sslmode=disable

# AI Models - FULL LOCAL NEX-AI
NEX_AI_ENDPOINT=http://127.0.0.1:11434/api/chat
NEX_AI_MODEL_REFLEX=nex-ai-reflex
NEX_AI_MODEL_REASONING=nex-ai-protect
NEX_AI_API_KEY=dummy-key-for-local-usage

# ⚔️ NEX-RED Autonomous Red Team Bridge
NEX_RED_BRIDGE_URL=http://127.0.0.1:3004

# Honeypot & SSH Tarpit
HONEYPOT_PORT=9090
SSH_TARPIT_PORT=2222

# Self-Healing
INTEGRITY_MONITORED_DIR="../playground/vulnerable-ojk-portal/templates"

# Security
CSRF_SECRET=change-this-in-production-csrf-secret-key
NEXUS_SESSION_SECRET=change-this-in-production-session-secret
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Threat Intelligence & Instant Push Notifications
THREAT_INTEL_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100123456789
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
BANK_SIEM_ENDPOINT=127.0.0.1:514
BANK_SIEM_PROTOCOL=tcp
