# Nexus Cyber Core Gateway - Environment Variables
# Copy this file to .env and fill in your values
# ===================================================

# API & Licensing
PORT=8080
# SOC control plane (not the public WAF). Loopback default for start-dev.bat.
ADMIN_LISTEN=127.0.0.1:8081
# Required for non-loopback callers (Docker). Empty + loopback = start-dev without login.
NEXUS_ADMIN_TOKEN=
# Allow http://127.0.0.1 origins when adding routes from a local SOC (on-prem). Leave unset in internet-facing labs.
NEXUS_ALLOW_PRIVATE_ORIGINS=true
# Reverse proxies allowed to set X-Forwarded-For (loopback + Docker). Hotspot clients are not proxies.
NEXUS_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
SAAS_LICENSE_API_URL=http://127.0.0.1:3003/api/license
NEXUS_LICENSE_DOMAIN=localhost
NEXUS_LICENSE_KEY=nexus-cyber-dev
LICENSE_GRACE_PERIOD_MINUTES=360
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXUS_PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret

# Target Backend (Protected Application)
TARGET_BACKEND_HOST=localhost
TARGET_BACKEND=http://127.0.0.1:3001
# One hostname this instance will name for TLS ask / CNAME (not multi-tenant legacy list).
PROTECTED_HOST=portfolio.nexus-lab.test

# Golden GET cache at the WAF (RAM). Default: on for https origins (Vercel), off for http docker/loopback.
# NEXUS_GOLDEN_GET_CACHE=0
# NEXUS_GOLDEN_GET_TTL_SECONDS=60
# NEXUS_GOLDEN_GET_STALE_SECONDS=3600

# Redis (Bound to 127.0.0.1)
REDIS_URL=127.0.0.1:6379

# PostgreSQL (Bound to 127.0.0.1)
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/nexus_cyber_gateway?sslmode=disable

# AI Models - FULL LOCAL NEX-AI
NEX_AI_ENDPOINT=http://127.0.0.1:11434/api/chat
NEX_AI_MODEL_REFLEX=nex-ai-reflex
NEX_AI_MODEL_REASONING=nex-ai-protect
NEX_AI_API_KEY=dummy-key-for-local-usage

# ⚔️ NEX-RED Autonomous Red Team Bridge
NEX_RED_BRIDGE_URL=http://127.0.0.1:3004

# Honeypot & SSH Tarpit
HONEYPOT_PORT=9090
SSH_TARPIT_PORT=2222

# Self-heal (deface restore without stopping the origin). Pin lives beside the tree, not inside it.
# Default lab origin source: playground/Portofolio-Thoriq (PRODUCT_MODEL). Skip node_modules/.git/.next.
INTEGRITY_MONITORED_DIR="../playground/Portofolio-Thoriq"
# Docker START-OFFLINE: /origin-lab/dist (sama dengan file yang di-serve origin).
# INTEGRITY_BASELINE_PATH=../playground/.nexus-integrity-baseline.json
# INTEGRITY_REPIN=1

# Security
CSRF_SECRET=change-this-in-production-csrf-secret-key
NEXUS_SESSION_SECRET=change-this-in-production-session-secret
# Operator/Job only. Empty = fail-closed (named-host visitors still solve PoW).
# NEXUS_LAB_SESSION_TOKEN=
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Threat Intelligence & Instant Push Notifications
# Lab: isi TELEGRAM_* di deploy-local/.env. Kosong = log lokal. Jangan commit token sungguhan.
THREAT_INTEL_PROVIDER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ABUSEIPDB_API_KEY=
BANK_SIEM_ENDPOINT=127.0.0.1:514
BANK_SIEM_PROTOCOL=tcp
