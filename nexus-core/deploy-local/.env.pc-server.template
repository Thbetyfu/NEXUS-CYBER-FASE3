# =============================================================================
# Nexus Cyber — template ENV untuk PC SERVER UTAMA (24/7 + juri / tunnel)
# =============================================================================
# CARA PAKAI (pilih satu):
#   A) Otomatis + password acak:  deploy-local\jury\SETUP-ENV-PC-SERVER.bat
#   B) Manual: salin file ini ke deploy-local\.env lalu isi baris [WAJIB]
#
# CHECKLIST sebelum START-FOR-JURY.bat:
#   [ ] POSTGRES_PASSWORD          — diganti (min ~16 karakter)
#   [ ] POSTGRES_DSN               — password sama dengan baris di atas
#   [ ] NEXUS_SESSION_SECRET       — diganti (random panjang)
#   [ ] REWARD_PASSWORD            — diganti
#   [ ] NEXUS_ADMIN_TOKEN          — diganti (simpan untuk login SOC lokal)
#   [ ] (opsional) TELEGRAM_*       — alert ke HP
#   [ ] (opsional) NEX_AI_*         — setelah Ollama + model nex-ai-* terpasang
#
# JANGAN commit file .env ke git.
# Docs: docs/PC_MAIN_SERVER.md §2
# =============================================================================

# --- Origin (mode OFFLINE / jury pakai START-OFFLINE — compose override ke portfolio lokal) ---
# Untuk START.bat (Vercel): biarkan URL di bawah.
# Untuk jury/PC server: START-FOR-JURY memakai overlay offline; baris ini jarang dipakai.
TARGET_BACKEND=https://portfolio-website-three-ruddy-65.vercel.app
TARGET_BACKEND_HOST=portfolio-website-three-ruddy-65.vercel.app

# Hostname situs di belakang WAF (lab). Tunnel quick: juri buka trycloudflare, bukan nama ini.
PROTECTED_HOST=portfolio.nexus-lab.test

# --- [WAJIB] Database (Postgres hanya localhost — tidak di-tunnel) ---
POSTGRES_PASSWORD=__GANTI_POSTGRES_PASSWORD__
POSTGRES_DSN=postgres://nexus:__GANTI_POSTGRES_PASSWORD__@postgres:5432/nexus_cyber?sslmode=disable
REDIS_URL=redis:6379

# Control plane SOC — JANGAN di-tunnel ke internet
NEXUS_CONTROL_PLANE_URL=http://127.0.0.1:8081

# Lisensi lab (bukan produksi billing)
NEXUS_LICENSE_KEY=nexus-cyber-dev
NEXUS_LICENSE_DOMAIN=localhost

# --- [WAJIB] Keamanan sesi & operator ---
NEXUS_SESSION_SECRET=__GANTI_SESSION_SECRET__
REWARD_PASSWORD=__GANTI_REWARD_PASSWORD__
REWARD_LINK=https://shopee.co.id/m/shopee-kaget-nexus-success

# --- [WAJIB] Token login SOC lokal (:8081) — simpan di password manager ---
NEXUS_ADMIN_TOKEN=__GANTI_ADMIN_TOKEN__

# --- NEX-RED (scan/job lewat WAF — bukan URL Vercel langsung) ---
NEX_RED_LIVE_TARGET=http://portfolio.nexus-lab.test
# NEX_RED_BROWSER=0

# --- NEX-AI lokal (wajib untuk START.bat / START-FOR-JURY.bat) ---
# Bukan unduhan Ollama Hub. Salin nex_ai_q4_k_m.gguf ke nex-ai-models\
# lalu IMPORT-OLLAMA.bat. CI saja: NEX_AI_REQUIRED=0
NEX_AI_REQUIRED=1
NEX_AI_ENDPOINT=http://host.docker.internal:11434/api/chat
NEX_AI_MODEL_REFLEX=nex-ai-reflex
NEX_AI_MODEL_REASONING=nex-ai-protect
NEX_AI_API_KEY=dummy-key-for-local-usage

# Jangan isi model cloud sebagai pengganti nex-ai-* (AGENTS.md)
OPENROUTER_API_KEY=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=

# --- Hotspot blue/red team (TIDAK dipakai untuk juri publik) ---
NEXUS_HOTSPOT_SSID=NEXUS-BLUE-LAB
NEXUS_HOTSPOT_PASS=NexusBlue1

# --- Telegram pager (opsional) ---
# BotFather → token. Chat ID: /start ke bot → getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# THREAT_INTEL_PROVIDER=telegram

# --- Channel Portal pilot (bukan di-tunnel lewat compose; npm :3003 + python :3010) ---
# Salin ke nexus-gaas-web/.env.local untuk instance HP/cellular:
# NEXUS_LEDGER_MODE=live
# NEXUS_LAB_FAUCET=0
# CHANNEL_STARTER_URL=http://127.0.0.1:3010
# CHANNEL_STARTER_PUBLIC_URL=/starter

