# Channel Starter — env opsional (default sudah cukup untuk lab PC)
# Set di PowerShell sesi atau System Environment sebelum: python cli.py generate ...

# Folder output site
# CHANNEL_STARTER_SITES_DIR=./sites

# Subdomain lab (lokal + hosts file)
CHANNEL_STARTER_SUBDOMAIN_BASE=nexus-lab.test

# Lab HTTP tanpa TLS; produksi named tunnel: false + DNS wildcard
CHANNEL_STARTER_HTTP_ONLY=true

# Port form wizard / API
CHANNEL_STARTER_PORT=3010

# --- Produksi nanti (named tunnel + domain) ---
# CHANNEL_STARTER_SUBDOMAIN_BASE=sites.nexus.id
# CHANNEL_STARTER_HTTP_ONLY=false
