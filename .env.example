# Nexus Cyber Fase 3 - Core Defense & Offensive Validation Grid
# ====================================================================

# 🔑 AI & API Keys (Dual-Brain NEX-AI)
NEX_AI_PROVIDER=ollama
NEX_AI_BASE_URL=http://127.0.0.1:11434
NEX_AI_MODEL_REFLEX=nex-ai-reflex
NEX_AI_MODEL_REASONING=nex-ai-protect
# Jangan isi Qwen/Llama di sini. Model milik Nexus, didaftarkan lokal sebagai nex-ai-protect.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ⚔️ NEX-RED (Autonomous Red Team Engine)
NEX_RED_BRIDGE_HOST=127.0.0.1
NEX_RED_BRIDGE_PORT=3004
NEX_RED_REPORTS_DIR=NEX-RED/reports
NEX_RED_WORKSPACES_DIR=NEX-RED/workspaces
NEX_RED_LIVE_TARGET=http://127.0.0.1
# Juice Shop class lab (loopback only). Start NEX-RED/lab/juice-shop/START.bat
NEX_RED_JUICE_SHOP_URL=http://127.0.0.1:3003
# NEX_RED_MAX_LIVE_STEPS=20
# NEX_RED_MAX_LIVE_MINUTES=30
# Browser lab (unggah + 5 password). 0 = mati (default CI).
# NEX_RED_BROWSER=0
# Opsional: dua akun untuk cek IDOR hidup (jangan commit token sungguhan)
# NEX_RED_IDOR_OWNER_TOKEN=
# NEX_RED_IDOR_PEER_TOKEN=
# NEX_RED_IDOR_OBJECT_PATH=/objects/1

# 🏛️ Core Gateway & Services
PORT=8080
ADMIN_LISTEN=127.0.0.1:8081
NEXUS_ADMIN_TOKEN=
NEXUS_GATEWAY_URL=http://127.0.0.1:8080
NEXUS_DASHBOARD_URL=http://127.0.0.1:3000
TARGET_BACKEND=http://127.0.0.1:3001

# 🔐 Session & Security
NEXUS_SESSION_SECRET=super-secret-matrix-key-2026-change-in-production
CSRF_SECRET=change-this-in-production-csrf-secret-key

# 🗄️ Database & Cache
REDIS_URL=127.0.0.1:6379
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/nexus_cyber_gateway?sslmode=disable

# 🛡️ Honeypot & Deception Ports
HONEYPOT_PORT=9090
SSH_TARPIT_PORT=2222
