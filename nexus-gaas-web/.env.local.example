# Nexus Channel Portal — salin ke .env.local jika perlu override
# Default v1: Channel Starter API di http://127.0.0.1:3010 (tanpa file ini pun jalan)

NEXT_PUBLIC_CHANNEL_STARTER_URL=http://127.0.0.1:3010
CHANNEL_STARTER_URL=http://127.0.0.1:3010

# Ledger Kredit. live = keran lab mati. Isi pelanggan = pending, bukan auto-credit.
NEXUS_LEDGER_MODE=lab
# 0 = sembunyikan/matikan keran lab. Default 1 di mode lab (uji generate, bukan tombol beli).
# NEXUS_LAB_FAUCET=1

# Approve isi ulang: POST /api/kredit/topup/approve dari 127.0.0.1, atau header x-nexus-operator-secret.
# NEXUS_OPERATOR_SECRET=

# Nomor WhatsApp isi ulang (default kode: SALES.whatsapp 62895603358692). Override opsional:
# NEXUS_TOPUP_PROOF_WA=

# Opsional: folder JSON identitas + ledger (default: ./data). File json + topup-proofs binary di-gitignore.
# NEXUS_PORTAL_DATA_DIR=

# Cookie nexus_portal_sid: httpOnly, SameSite=Lax, Secure jika NODE_ENV=production.
# Nomor DANA / QRIS / VA tidak diperlukan untuk login/register/tamu lab.

# Nanti (named tunnel + domain): ganti ke URL internal atau hostname publik
# NEXT_PUBLIC_CHANNEL_STARTER_URL=http://127.0.0.1:3010
# CHANNEL_STARTER_URL=http://127.0.0.1:3010
