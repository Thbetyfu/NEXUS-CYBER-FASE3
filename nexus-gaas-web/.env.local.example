# Nexus Channel Portal — salin ke .env.local
#
# Lab satu PC (npm run dev :3003 + wizard :3010):
#   CHANNEL_STARTER_URL = loopback (Node generate). Browser preview default /starter → rewrite ke :3010.
# Pilot publik (HP/cellular): tunnel HANYA :3003. Keran mati. Jangan tunnel :3001/:8081.

CHANNEL_STARTER_URL=http://127.0.0.1:3010
# Browser preview. Kosong = /starter (disarankan untuk tunnel storefront).
# CHANNEL_STARTER_PUBLIC_URL=/starter
# Lab langsung ke wizard (tanpa /starter): CHANNEL_STARTER_PUBLIC_URL=http://127.0.0.1:3010
# NEXT_PUBLIC_CHANNEL_STARTER_URL hanya untuk link browser — BUKAN target generate.

# Hostname tunnel (opsional, allowedDevOrigins). Contoh: xxx.trycloudflare.com
# NEXUS_PORTAL_PUBLIC_HOST=

# --- Lab di laptop (keran uji generate). Jangan ini di instance publik. ---
# NEXUS_LEDGER_MODE=lab
# NEXUS_LAB_FAUCET=1

# --- Pilot publik / HP luar (wajib) ---
NEXUS_LEDGER_MODE=live
NEXUS_LAB_FAUCET=0

# Approve isi ulang: UI http://127.0.0.1:3003/operator/topup (Host loopback).
# NEXUS_OPERATOR_SECRET=

# Nomor DANA tampilan isi ulang. Kosong = nomor WA publik pemilik (0895 6033 58692). Env mengalahkan.
# NEXUS_DANA_NUMBER=0895603358692
# Label tampilan opsional (mis. DANA atas nama …).
# NEXUS_DANA_LABEL=

# WhatsApp setelah Kirim bukti — opsional override; default SALES 62895603358692.
# NEXUS_TOPUP_PROOF_WA=

# Email pemilik untuk lampiran bukti. Tidak ada default di repo.
# NEXUS_TOPUP_PROOF_EMAIL=
# NEXUS_SMTP_HOST=
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_USER=
# NEXUS_SMTP_PASS=
# NEXUS_SMTP_FROM=
# NEXUS_SMTP_SECURE=0

# NEXUS_PORTAL_DATA_DIR=

# Model tulis lokal (langkah 3 fill cerita). Server portal saja — HP jangan hit :11434.
# Loopback only. Jangan tunnel. Bukan NEX-AI WAF (jangan nex-ai-protect / nex-ai-reflex).
NEXUS_LOCAL_LLM_URL=http://127.0.0.1:11434
NEXUS_LOCAL_LLM_MODEL=gemma3:1b

# --- Vercel storefront (copy only) ---
# Jangan CHANNEL_STARTER_URL ke laptop. Generate + fill LLM + /operator tetap di PC 24/7.
# Jangan NEXUS_LOCAL_LLM_URL di Vercel (runtime VERCEL=1 tidak fetch :11434).
# Named hostname butuh zona Cloudflare milik pemilik (belum ada) — jangan mengarang domain.
# CHANNEL_STARTER_URL=
# NEXUS_LOCAL_LLM_URL=
