# Nexus Cyber — lab lokal (bukan produksi)
# Salin ke .env atau biarkan START.bat menyalin otomatis.

# Origin yang dilindungi WAF (default: portofolio Vercel)
TARGET_BACKEND=https://portfolio-website-three-ruddy-65.vercel.app
TARGET_BACKEND_HOST=portfolio-website-three-ruddy-65.vercel.app

# Golden GET di WAF (default nyala karena origin https).
# NEXUS_GOLDEN_GET_CACHE=0
# NEXUS_GOLDEN_GET_TTL_SECONDS=60

# Satu nama untuk situs di belakang WAF (bukan registrar, bukan multi-tenant).
# Lab HTTP: tambah baris hosts → IP-laptop  portfolio.nexus-lab.test
# VPS + DNS publik ke mesin ini: Caddy :443 boleh minta sertifikat untuk nama ini saja.
PROTECTED_HOST=portfolio.nexus-lab.test

# Postgres / Redis (hanya untuk lab di laptop ini)
POSTGRES_PASSWORD=nexus_local_dev_only
POSTGRES_DSN=postgres://nexus:nexus_local_dev_only@postgres:5432/nexus_cyber?sslmode=disable
REDIS_URL=redis:6379

# NEX-RED Job Cowork → sinkron ke PostgreSQL via control plane
NEXUS_CONTROL_PLANE_URL=http://127.0.0.1:8081

# Lisensi development (offline bypass untuk localhost)
NEXUS_LICENSE_KEY=nexus-cyber-dev
NEXUS_LICENSE_DOMAIN=localhost

# Sesi & vault hadiah (ganti jika lab dibuka ke LAN)
NEXUS_SESSION_SECRET=nexus-local-session-change-me
REWARD_PASSWORD=NexusAccessSecure2026!
REWARD_LINK=https://shopee.co.id/m/shopee-kaget-nexus-success

# NEX-AI lokal (Ollama di laptop, bukan di dalam container).
# Lab START fail-closed: nex-ai-protect DAN nex-ai-reflex harus ada di Ollama.
# Bobot BUKAN unduhan Ollama Hub. Salin nex_ai_q4_k_m.gguf ke nex-ai-models\
# lalu jalankan nex-ai-models\IMPORT-OLLAMA.bat. Jangan ollama pull qwen/llama/gpt.
# CI / uji tanpa model: NEX_AI_REQUIRED=0 (eksplisit; bukan fallback Hub).
NEX_AI_REQUIRED=1
NEX_AI_ENDPOINT=http://host.docker.internal:11434/api/chat
NEX_AI_MODEL_REFLEX=nex-ai-reflex
NEX_AI_MODEL_REASONING=nex-ai-protect
NEX_AI_API_KEY=dummy-key-for-local-usage

# Opsional cloud (kosong = jangan dipakai). Runtime wajib nex-ai-*, bukan Qwen Hub.
OPENROUTER_API_KEY=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=

# Target hidup untuk NEX-RED (lewat WAF + hostname, bukan URL Vercel langsung)
NEX_RED_LIVE_TARGET=http://portfolio.nexus-lab.test
# NEX_RED_BROWSER=0
# PLAYWRIGHT_BROWSERS_PATH=../NEX-RED/workspaces/.playwright-browsers
# Lab session for Playwright gallery/vault through WAF (same value on gateway + Job).
# NEXUS_LAB_SESSION_TOKEN=
# NEX_RED_LAB_SESSION_TOKEN=
# Opsional dua akun (IDOR). Kosong = NEX-RED hanya mencatat “lab pair tidak ada”.
# NEX_RED_IDOR_OWNER_TOKEN=
# NEX_RED_IDOR_PEER_TOKEN=
# NEX_RED_IDOR_OBJECT_PATH=/objects/1

# Twin lab origin for NEX-RED (HTTP only). Jangan isi URL Vercel publik.
# NEX_RED_ORIGIN_DIRECT=http://127.0.0.1:3002
# auto = hanya jika target IP privat bukan loopback. 1 = paksa. 0 = mati.
# NEX_RED_HOTSPOT_HARNESS=auto

# SOC control plane (hanya 127.0.0.1:8081). Bukan untuk hotspot red team.
NEXUS_ADMIN_TOKEN=nexus-local-admin-token-change-me

# Hotspot lab Windows (blue-team). Password min 8 karakter.
NEXUS_HOTSPOT_SSID=NEXUS-BLUE-LAB
NEXUS_HOTSPOT_PASS=NexusBlue1

# Pager Telegram (opsional). Isi di .env laptop blue team — jangan commit token.
# BotFather → token. Chat ID: kirim /start ke bot, lalu getUpdates.
# Laptop blue team butuh internet keluar ke api.telegram.org (Ethernet disarankan).
# Kosong = hanya log lokal. THREAT_INTEL_PROVIDER=local mematikan pager meski token ada.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# THREAT_INTEL_PROVIDER=telegram

# Self-heal: folder origin lab (Docker START/OFFLINE memasang Portofolio ke /origin-lab)
# INTEGRITY_MONITORED_DIR=/origin-lab
# INTEGRITY_BASELINE_PATH=/app/data/integrity-baseline.json
# INTEGRITY_REPIN=1
