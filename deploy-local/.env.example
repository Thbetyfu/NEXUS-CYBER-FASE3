# Nexus Cyber — lab lokal (bukan produksi)
# Salin ke .env atau biarkan START.bat menyalin otomatis.

# Origin yang dilindungi WAF (default: portofolio Vercel)
TARGET_BACKEND=https://portfolio-website-three-ruddy-65.vercel.app
TARGET_BACKEND_HOST=portfolio-website-three-ruddy-65.vercel.app

# Postgres / Redis (hanya untuk lab di laptop ini)
POSTGRES_PASSWORD=nexus_local_dev_only
POSTGRES_DSN=postgres://nexus:nexus_local_dev_only@postgres:5432/nexus_cyber?sslmode=disable
REDIS_URL=redis:6379

# Lisensi development (offline bypass untuk localhost)
NEXUS_LICENSE_KEY=nexus-cyber-dev
NEXUS_LICENSE_DOMAIN=localhost

# Sesi & vault hadiah (ganti jika lab dibuka ke LAN)
NEXUS_SESSION_SECRET=nexus-local-session-change-me
REWARD_PASSWORD=NexusAccessSecure2026!
REWARD_LINK=https://shopee.co.id/m/shopee-kaget-nexus-success

# Opsional: Dual-Brain reasoning via OpenRouter (kosong = Reflex regex saja)
OPENROUTER_API_KEY=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=

# Target hidup untuk NEX-RED (lewat WAF, bukan URL Vercel langsung)
NEX_RED_LIVE_TARGET=http://127.0.0.1
# NEX_RED_BROWSER=0
# Opsional dua akun (IDOR). Kosong = NEX-RED hanya mencatat “lab pair tidak ada”.
# NEX_RED_IDOR_OWNER_TOKEN=
# NEX_RED_IDOR_PEER_TOKEN=
# NEX_RED_IDOR_OBJECT_PATH=/objects/1

# SOC control plane (hanya 127.0.0.1:8081). Bukan untuk hotspot red team.
NEXUS_ADMIN_TOKEN=nexus-local-admin-token-change-me

# Hotspot lab Windows (blue-team). Password min 8 karakter.
NEXUS_HOTSPOT_SSID=NEXUS-BLUE-LAB
NEXUS_HOTSPOT_PASS=NexusBlue1
